# Servidor Linux nativo (uv + systemd) — banco em data/repercussao.db
DATABASE_URL=sqlite+pysqlite:///./data/repercussao.db
APP_ENV=production
LOCAL_AUTH_BYPASS=false
# GERAR CHAVE UNICA: openssl rand -hex 32. Nunca comitar seu .env.
LOCAL_SESSION_SECRET=
# Administrar usuarios: uv run python -m app.local_users create --email voce@instituicao.br --admin
# Alternativa opcional para Postgres local:
# DATABASE_URL=postgresql+psycopg://relatorio:SENHA@127.0.0.1:5432/repercussao
# Pool (banco gerenciado limita conexões)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# Todas as tarefas LLM usam exclusivamente a API oficial da OpenAI.
# Obtenha a chave no painel da OpenAI; NUNCA salve credenciais no Git.
OPENAI_ONLY=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL nao deve ser configurada no modo exclusivo.
# OPENAI_FALLBACK_* e Ollama nao sao utilizados.
OPENAI_REASONING_EFFORT=low
CORPUS_EMBEDDING_PROVIDER=openai
CORPUS_EMBEDDING_MODEL=text-embedding-3-small
CORPUS_EMBEDDING_FALLBACK_LOCAL=false
# Auditoria narrativa por LLM no QA (deterministico e sempre obrigatorio)
ENABLE_LLM_QA=true
# Rodadas automaticas redacao -> QA (cada uma custa 1 redacao + 1 QA; 0 desliga)
MAX_QA_REFINEMENTS=2
# Margem repassada ao cliente sobre o custo LLM (10 = +10%)
BILLING_MARGIN_PCT=10
# Consulta adicional para preencher lacunas apos a validacao do corpus.
MAX_GAP_FILL_QUERIES=4

# Search strategy: quality over query count
MAX_COMPLEMENTARY_QUERIES=2
MAX_MEDIA_QUERIES=24
MAX_FACT_QUERIES=1
# Consultas oficiais mensais podem somar varias fontes x 12 meses.
MAX_OFFICIAL_QUERIES=60
ENABLE_ANNUAL_EVENT_INVENTORY=true
MAX_ANNUAL_EVENT_INVENTORY_QUERIES=12
ENABLE_OFFICIAL_ANNUAL_INVENTORY=true
MAX_OFFICIAL_INVENTORY_QUERIES=60
MAX_NOMINAL_QUERIES=12

# Media corpus target and hard ceiling
TARGET_MEDIA_ITEMS=27
MAX_NEW_MEDIA_ITEMS=40
# Estatistica de compatibilidade; NAO e mais teto rigido do retorno bruto.
MAX_SEARCH_RESULTS=250
MAX_RESULTS_PER_QUERY=8
MAX_PRIORITY_RESULTS_PER_QUERY=8
AGENT_SEARCH_MAX_RESULTS=8

# Independent factual/official budgets
MAX_FACT_SEARCH_RESULTS=12
MAX_OFFICIAL_SEARCH_RESULTS=12
MAX_NOMINAL_SEARCH_RESULTS=12

# LLM processing budgets
MAX_FACT_SOURCE_CHARS=16000
MAX_SEMANTIC_REVIEWS=40
MAX_FACT_EXTRACTIONS=20
MAX_CLASSIFICATIONS=40
MAX_CROSS_VALIDATIONS=20
VALIDATION_BATCH_SIZE=10
CLASSIFICATION_BATCH_SIZE=10
VALIDATION_ITEM_MAX_CHARS=4000
CLASSIFICATION_ITEM_MAX_CHARS=6000

# Agent and DuckDuckGo
MAX_AGENT_TOOL_ROUNDS=3
# Paraleliza somente I/O externo; persistência/auditoria no banco continua sequencial.
SEARCH_PARALLEL_ENABLED=true
SEARCH_PARALLEL_WEB_WORKERS=4
SEARCH_PARALLEL_VIDEO_WORKERS=3
DUCKDUCKGO_REGION=br-pt
DUCKDUCKGO_SAFESEARCH=moderate
DUCKDUCKGO_MAX_RETRIES=2
DUCKDUCKGO_RETRY_BASE_SECONDS=0.8
DUCKDUCKGO_FETCH_PAGES=true
DUCKDUCKGO_FETCH_MAX_CHARS=12000
DUCKDUCKGO_FETCH_TIMEOUT_SECONDS=10

# Video. O total global e apenas estatistica legada; nao descarta hits brutos.
MAX_YOUTUBE_TASKS=12
MAX_YOUTUBE_RESULTS_TOTAL=120
MAX_YOUTUBE_RESULTS_PER_TASK=5

# Reuso historico (dias). 0 desliga a expiracao; recortes de datas explicitos
# continuam reaproveitando artigos dentro da janela, mesmo mais antigos.
CORPUS_REUSE_MAX_AGE_DAYS=180

# MAX_SEARCH_QUERIES e legado (limites por finalidade prevalecem).
# MAX_SEARCH_QUERIES=30

# Social: DuckDuckGo descobre posts mesmo sem token Apify.
# Ligue APIFY_SOCIAL_ENABLED somente com APIFY_API_TOKEN configurado.
SOCIAL_DISCOVERY_ENABLED=true
SOCIAL_DISCOVERY_QUERIES_PER_PLATFORM=3
SOCIAL_DISCOVERY_RESULTS_PER_QUERY=8
APIFY_API_TOKEN=
APIFY_SOCIAL_ENABLED=false
APIFY_INSTAGRAM_COMMENTS_ACTOR_ID=apify/instagram-comment-scraper
APIFY_FACEBOOK_COMMENTS_ACTOR_ID=apify/facebook-comments-scraper
APIFY_TIKTOK_COMMENTS_ACTOR_ID=clockworks/tiktok-comments-scraper
# X usa Actor comunitario; pode ser trocado por outro compativel.
APIFY_X_COMMENTS_ACTOR_ID=scraper_one/x-post-replies-scraper
APIFY_SOCIAL_MAX_POSTS_PER_PLATFORM=8
APIFY_SOCIAL_COMMENTS_PER_POST=50
APIFY_SOCIAL_TIMEOUT_SECONDS=240
SOCIAL_ANALYSIS_MAX_COMMENTS=120
SOCIAL_ANALYSIS_BATCH_SIZE=30
