DATABASE_URL=postgresql+psycopg://relatorio:relatorio@postgres:5432/repercussao
# Supabase (session pooler): postgresql+psycopg://postgres:SENHA@db.<ref>.supabase.co:6543/postgres?sslmode=require
# Pool (banco gerenciado limita conexões)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# So para modelos reasoning (gpt-5/o-series): minimal, low, medium, high ou vazio
OPENAI_REASONING_EFFORT=low
# Auditoria narrativa por LLM no QA (deterministico e sempre obrigatorio)
ENABLE_LLM_QA=true
# Rodadas automaticas redacao -> QA (cada uma custa 1 redacao + 1 QA; 0 desliga)
MAX_QA_REFINEMENTS=2
# Consultas web abertas da cobertura complementar (fase 2; 1 rodada por projeto)
MAX_GAP_FILL_QUERIES=4
APP_ENV=development

# Search strategy: quality over query count
MAX_COMPLEMENTARY_QUERIES=2
MAX_MEDIA_QUERIES=12
MAX_FACT_QUERIES=1
MAX_OFFICIAL_QUERIES=3
MAX_NOMINAL_QUERIES=12

# Media corpus target and hard ceiling
TARGET_MEDIA_ITEMS=27
MAX_NEW_MEDIA_ITEMS=40
MAX_SEARCH_RESULTS=40
MAX_RESULTS_PER_QUERY=8
MAX_PRIORITY_RESULTS_PER_QUERY=2
AGENT_SEARCH_MAX_RESULTS=8

# Independent factual/official budgets
MAX_FACT_SEARCH_RESULTS=12
MAX_OFFICIAL_SEARCH_RESULTS=6
MAX_NOMINAL_SEARCH_RESULTS=12

# LLM processing budgets
MAX_FACT_SOURCE_CHARS=16000
MAX_SEMANTIC_REVIEWS=40
MAX_FACT_EXTRACTIONS=20
MAX_CLASSIFICATIONS=40
MAX_CROSS_VALIDATIONS=20
VALIDATION_BATCH_SIZE=10
CLASSIFICATION_BATCH_SIZE=10
VALIDATION_ITEM_MAX_CHARS=4000
CLASSIFICATION_ITEM_MAX_CHARS=6000

# Agent and DuckDuckGo
MAX_AGENT_TOOL_ROUNDS=3
DUCKDUCKGO_REGION=br-pt
DUCKDUCKGO_SAFESEARCH=moderate
DUCKDUCKGO_MAX_RETRIES=2
DUCKDUCKGO_RETRY_BASE_SECONDS=0.8
DUCKDUCKGO_FETCH_PAGES=true
DUCKDUCKGO_FETCH_MAX_CHARS=12000
DUCKDUCKGO_FETCH_TIMEOUT_SECONDS=10

# Video
MAX_YOUTUBE_TASKS=12
MAX_YOUTUBE_RESULTS_TOTAL=20
MAX_YOUTUBE_RESULTS_PER_TASK=5

# Historical corpus reuse (validity in days; 0 disables expiry)
CORPUS_REUSE_MAX_AGE_DAYS=180

# Deprecated compatibility setting; new planner uses per-purpose budgets above.
MAX_SEARCH_QUERIES=30
